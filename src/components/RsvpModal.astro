---
// RsvpModal.astro — RSVP confirmation modal with Google Sheets backend
---

<!-- ── Trigger Button ── -->
<button
  id="btn-rsvp"
  class="bg-gradient-to-r from-pink-600 to-purple-600 text-white px-10 py-4 rounded-sm font-black text-xl uppercase tracking-widest hover:scale-105 transition-transform duration-300 shadow-[0_0_20px_rgba(236,72,153,0.4)] clip-path-slant cursor-pointer"
>
  Confirmar Asistencia
</button>

<!-- ── Modal ── -->
<div
  id="rsvp-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="rsvp-modal-title"
  aria-hidden="true"
  class="rsvp-modal-root"
>
  <div id="rsvp-backdrop" class="rsvp-backdrop"></div>

  <div id="rsvp-panel" class="rsvp-panel" tabindex="-1">
    <!-- Header -->
    <div class="rsvp-header">
      <h2 id="rsvp-modal-title" class="rsvp-title">Confirmar Asistencia</h2>
      <button id="rsvp-close" class="rsvp-close-btn" aria-label="Cerrar">&times;</button>
    </div>

    <!-- Form -->
    <form id="rsvp-form" class="rsvp-form" novalidate>
      <!-- Honeypot (hidden from humans) -->
      <input
        type="text"
        name="website"
        id="rsvp-honeypot"
        autocomplete="off"
        tabindex="-1"
        aria-hidden="true"
        class="rsvp-honeypot"
      />

      <div class="rsvp-field">
        <label for="rsvp-nombre" class="rsvp-label">Nombre <span class="rsvp-required">*</span></label>
        <input
          type="text"
          id="rsvp-nombre"
          name="nombre"
          class="rsvp-input"
          required
          autocomplete="given-name"
          placeholder="Tu nombre"
        />
      </div>

      <div class="rsvp-field">
        <label for="rsvp-apellido" class="rsvp-label">Apellido <span class="rsvp-required">*</span></label>
        <input
          type="text"
          id="rsvp-apellido"
          name="apellido"
          class="rsvp-input"
          required
          autocomplete="family-name"
          placeholder="Tu apellido"
        />
      </div>

      <!-- Bus checkbox -->
      <label class="rsvp-checkbox-label" for="rsvp-colectivo">
        <input type="checkbox" id="rsvp-colectivo" name="colectivo" class="rsvp-checkbox" />
        <span class="rsvp-checkbox-box"></span>
        <span class="rsvp-checkbox-text">
          <strong>🚌 Voy en el colectivo</strong>
          <span class="rsvp-checkbox-hint">Ida y vuelta organizado</span>
        </span>
      </label>

      <div id="rsvp-status" class="rsvp-status" aria-live="polite" aria-atomic="true"></div>

      <button type="submit" id="rsvp-submit" class="rsvp-submit-btn">
        Confirmar
      </button>
    </form>
  </div>

  <!-- ── Confirmation panel (slides in over the form) ── -->
  <div id="rsvp-confirm-panel" class="rsvp-confirm-panel" aria-hidden="true">
    <div class="rsvp-header">
      <h2 class="rsvp-title">¿Todo bien?</h2>
      <button id="rsvp-confirm-back" class="rsvp-close-btn" aria-label="Volver">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
    </div>
    <div class="rsvp-confirm-body">
      <p class="rsvp-confirm-intro">Revisá tus datos antes de confirmar:</p>

      <div class="rsvp-confirm-row">
        <span class="rsvp-confirm-label">Nombre</span>
        <span id="rsvp-confirm-nombre" class="rsvp-confirm-value"></span>
      </div>
      <div class="rsvp-confirm-row">
        <span class="rsvp-confirm-label">Apellido</span>
        <span id="rsvp-confirm-apellido" class="rsvp-confirm-value"></span>
      </div>
      <div class="rsvp-confirm-row">
        <span class="rsvp-confirm-label">Colectivo</span>
        <span id="rsvp-confirm-colectivo" class="rsvp-confirm-value"></span>
      </div>

      <!-- Bus warning — shown only if colectivo is unchecked -->
      <div id="rsvp-bus-warning" class="rsvp-bus-warning" aria-hidden="true">
        <span class="rsvp-bus-warning-icon">⚠️</span>
        <div>
          <strong>¿Olvidaste el colectivo?</strong>
          <p>No marcaste que vas en el colectivo. Si querés sumarte, volvé y tildá la opción.</p>
        </div>
      </div>

      <div class="rsvp-confirm-actions">
        <button id="rsvp-confirm-edit" class="rsvp-confirm-edit-btn">Editar</button>
        <button id="rsvp-confirm-send" class="rsvp-submit-btn" style="flex:1">Sí, confirmar</button>
      </div>
    </div>
  </div>
</div>

<style>
  /* ── Root overlay ── */
  .rsvp-modal-root {
    position: fixed;
    inset: 0;
    z-index: 9100;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .rsvp-modal-root[aria-hidden="false"] {
    pointer-events: auto;
  }

  /* ── Backdrop ── */
  .rsvp-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0);
  }

  /* ── Panel / Card ── */
  .rsvp-panel {
    position: relative;
    width: 92vw;
    max-width: 480px;
    max-height: 90dvh;
    max-height: 90vh; /* fallback */
    display: flex;
    flex-direction: column;
    background: rgba(10, 10, 10, 0.96);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 12px;
    box-shadow:
      0 0 40px rgba(236, 72, 153, 0.18),
      0 24px 64px rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    overflow: hidden;
    opacity: 0;
    transform: scale(0.85) translateY(40px);
    outline: none;
  }

  /* ── Header ── */
  .rsvp-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.1rem 1.4rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(0, 0, 0, 0.5);
  }

  .rsvp-title {
    font-size: 1rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #fff;
    margin: 0;
  }

  .rsvp-close-btn {
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.5);
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
    padding: 0 0.25rem;
    transition: color 0.2s;
  }

  .rsvp-close-btn:hover {
    color: #fff;
  }

  /* ── Form body ── */
  .rsvp-form {
    padding: 1.5rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    overflow-y: auto;
    flex: 1 1 auto;
    overscroll-behavior: contain;
  }

  .rsvp-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .rsvp-label {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.7);
  }

  .rsvp-required {
    color: #ec4899;
  }

  .rsvp-optional {
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    color: rgba(255, 255, 255, 0.35);
  }

  .rsvp-input {
    width: 100%;
    box-sizing: border-box;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 6px;
    color: #fff;
    font-family: inherit;
    font-size: 1rem;
    padding: 0.65rem 0.85rem;
    transition:
      border-color 0.2s,
      background 0.2s;
    outline: none;
  }

  .rsvp-input::placeholder {
    color: rgba(255, 255, 255, 0.25);
  }

  .rsvp-input:focus {
    border-color: #ec4899;
    background: rgba(236, 72, 153, 0.07);
    box-shadow: 0 0 0 2px rgba(236, 72, 153, 0.2);
  }

  /* ── Submit button ── */
  .rsvp-submit-btn {
    margin-top: 0.25rem;
    width: 100%;
    padding: 0.8rem 1rem;
    background: linear-gradient(to right, #db2777, #9333ea);
    color: #fff;
    font-family: inherit;
    font-weight: 900;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition:
      opacity 0.2s,
      transform 0.15s;
  }

  .rsvp-submit-btn:hover:not(:disabled) {
    transform: scale(1.02);
  }

  .rsvp-submit-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }

  /* ── Status message ── */
  .rsvp-status {
    font-size: 0.9rem;
    font-weight: 600;
    text-align: center;
    min-height: 1.2em;
    color: transparent;
  }

  .rsvp-status.is-success {
    color: #4ade80;
  }

  .rsvp-status.is-error {
    color: #f87171;
  }

  /* ── Bus checkbox ── */
  .rsvp-checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    cursor: pointer;
    padding: 0.85rem 1rem;
    border: 1px solid rgba(6, 182, 212, 0.25);
    border-radius: 8px;
    background: rgba(6, 182, 212, 0.05);
    transition: border-color 0.2s, background 0.2s;
  }

  .rsvp-checkbox-label:hover {
    border-color: rgba(6, 182, 212, 0.55);
    background: rgba(6, 182, 212, 0.1);
  }

  .rsvp-checkbox {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  .rsvp-checkbox-box {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    border: 2px solid rgba(6, 182, 212, 0.5);
    border-radius: 5px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.2s, background 0.2s;
  }

  .rsvp-checkbox:checked + .rsvp-checkbox-box {
    background: #06b6d4;
    border-color: #06b6d4;
  }

  .rsvp-checkbox:checked + .rsvp-checkbox-box::after {
    content: '';
    display: block;
    width: 6px;
    height: 11px;
    border: 2.5px solid #000;
    border-top: none;
    border-left: none;
    transform: rotate(45deg) translate(-1px, -1px);
  }

  .rsvp-checkbox-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.9);
  }

  .rsvp-checkbox-hint {
    font-size: 0.72rem;
    color: rgba(6, 182, 212, 0.7);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* ── Confirmation panel ── */
  .rsvp-confirm-panel {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    background: rgba(10, 10, 10, 0.98);
    border-radius: 12px;
    overflow: hidden;
    transform: translateX(100%);
    z-index: 2;
  }

  .rsvp-confirm-body {
    padding: 1.5rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    overflow-y: auto;
    flex: 1 1 auto;
  }

  .rsvp-confirm-intro {
    font-size: 0.8rem;
    color: rgba(255,255,255,0.45);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.25rem;
  }

  .rsvp-confirm-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 0.85rem;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 6px;
  }

  .rsvp-confirm-label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: rgba(255,255,255,0.4);
  }

  .rsvp-confirm-value {
    font-size: 0.95rem;
    font-weight: 700;
    color: #fff;
  }

  /* Bus warning box */
  .rsvp-bus-warning {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 0.85rem 1rem;
    background: rgba(251,191,36,0.08);
    border: 1px solid rgba(251,191,36,0.35);
    border-radius: 8px;
    font-size: 0.82rem;
    color: rgba(253,224,132,0.9);
    line-height: 1.5;
  }

  .rsvp-bus-warning[aria-hidden="true"] { display: none; }

  .rsvp-bus-warning-icon {
    font-size: 1.2rem;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .rsvp-bus-warning strong {
    display: block;
    margin-bottom: 0.2rem;
    color: rgb(253,224,132);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .rsvp-bus-warning p {
    margin: 0;
    color: rgba(253,224,132,0.75);
  }

  .rsvp-confirm-actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .rsvp-confirm-edit-btn {
    padding: 0.8rem 1.25rem;
    background: transparent;
    border: 1px solid rgba(255,255,255,0.2);
    color: rgba(255,255,255,0.7);
    font-family: inherit;
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-radius: 6px;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
    flex-shrink: 0;
  }

  .rsvp-confirm-edit-btn:hover {
    border-color: rgba(255,255,255,0.5);
    color: #fff;
  }

  /* ── Honeypot ── */
  .rsvp-honeypot {
    position: absolute;
    opacity: 0;
    height: 0;
    width: 0;
    pointer-events: none;
    overflow: hidden;
  }
</style>

<script>
  import { gsap } from "gsap"

  const SCRIPT_URL =
    "https://script.google.com/macros/s/AKfycbxiqCjEjcmMNeQJVu9IrbktSgE4zMav7ZtOQwriwPcQz3UTGpGsKVbNjPtnKwTm39phoQ/exec"

  // ── Element refs ──
  const modal    = document.getElementById("rsvp-modal")!
  // Portal: move modal to <body> so no transformed ancestor affects position:fixed
  document.body.appendChild(modal)

  const backdrop = document.getElementById("rsvp-backdrop")!
  const panel    = document.getElementById("rsvp-panel")!
  const btnOpen  = document.getElementById("btn-rsvp")!
  const btnClose = document.getElementById("rsvp-close")!
  const form     = document.getElementById("rsvp-form") as HTMLFormElement
  const submitBtn = document.getElementById("rsvp-submit") as HTMLButtonElement
  const statusEl = document.getElementById("rsvp-status")!
  const honeypot = document.getElementById("rsvp-honeypot") as HTMLInputElement
  const firstInput = document.getElementById("rsvp-nombre") as HTMLInputElement

  let isOpen = false

  // ── Focusable elements for focus trap ──
  const getFocusable = () =>
    Array.from(
      panel.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), input:not([tabindex="-1"]), textarea, select, [tabindex]:not([tabindex="-1"])'
      )
    ).filter((el) => !el.closest(".rsvp-honeypot") && el.getAttribute("aria-hidden") !== "true")

  // ── Open ──
  const openRsvp = () => {
    if (isOpen) return
    isOpen = true
    modal.setAttribute("aria-hidden", "false")
    ;(window as any).lenis?.stop()

    gsap
      .timeline()
      .to(backdrop, { backgroundColor: "rgba(0,0,0,0.75)", duration: 0.35, ease: "power2.out" }, 0)
      .fromTo(
        panel,
        { opacity: 0, scale: 0.85, y: 40 },
        { opacity: 1, scale: 1, y: 0, duration: 0.5, ease: "back.out(1.4)" },
        0.05
      )
      .add(() => {
        requestAnimationFrame(() => firstInput.focus())
      })
  }

  // ── Close ──
  const closeRsvp = () => {
    if (!isOpen) return
    isOpen = false
    gsap
      .timeline({
        onComplete: () => {
          modal.setAttribute("aria-hidden", "true")
          ;(window as any).lenis?.start()
        },
      })
      .to(panel, { opacity: 0, scale: 0.9, y: 30, duration: 0.3, ease: "power2.in" }, 0)
      .to(backdrop, { backgroundColor: "rgba(0,0,0,0)", duration: 0.3, ease: "power2.in" }, 0.05)
  }

  // ── Button wiring ──
  btnOpen.addEventListener("click", (e) => { e.preventDefault(); openRsvp() })
  btnClose.addEventListener("click", closeRsvp)
  backdrop.addEventListener("click", closeRsvp)

  document.addEventListener("keydown", (e) => {
    if (!isOpen) return

    if (e.key === "Escape") {
      closeRsvp()
      return
    }

    if (e.key === "Tab") {
      const focusable = getFocusable()
      if (focusable.length === 0) { e.preventDefault(); return }
      const first = focusable[0]
      const last = focusable[focusable.length - 1]

      if (e.shiftKey) {
        if (document.activeElement === first) {
          e.preventDefault()
          last.focus()
        }
      } else {
        if (document.activeElement === last) {
          e.preventDefault()
          first.focus()
        }
      }
    }
  })

  const confirmPanel  = document.getElementById("rsvp-confirm-panel")!
  const confirmNombre  = document.getElementById("rsvp-confirm-nombre")!
  const confirmApellido = document.getElementById("rsvp-confirm-apellido")!
  const confirmColectivo = document.getElementById("rsvp-confirm-colectivo")!
  const busWarning     = document.getElementById("rsvp-bus-warning")!
  const btnConfirmBack = document.getElementById("rsvp-confirm-back")!
  const btnConfirmEdit = document.getElementById("rsvp-confirm-edit")!
  const btnConfirmSend = document.getElementById("rsvp-confirm-send")!

  let pendingData: { nombre: string; apellido: string; colectivo: boolean } | null = null

  // ── Show / hide confirmation panel ──
  const showConfirm = (data: typeof pendingData) => {
    pendingData = data!
    confirmNombre.textContent = data!.nombre
    confirmApellido.textContent = data!.apellido
    confirmColectivo.textContent = data!.colectivo ? '\u2705 S\u00ed, voy en el colectivo' : '\u274c No'
    busWarning.setAttribute('aria-hidden', data!.colectivo ? 'true' : 'false')
    gsap.to(confirmPanel, { x: '0%', duration: 0.35, ease: 'power3.out' })
  }

  const hideConfirm = () => {
    gsap.to(confirmPanel, { x: '100%', duration: 0.28, ease: 'power3.in' })
  }

  btnConfirmBack.addEventListener('click', hideConfirm)
  btnConfirmEdit.addEventListener('click', hideConfirm)

  btnConfirmSend.addEventListener('click', async () => {
    if (!pendingData) return
    const data = pendingData
    pendingData = null
    hideConfirm()

    setStatus('', '')
    setSubmitting(true)

    try {
      const res = await fetch(SCRIPT_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify(data),
      })
      if (!res.ok) throw new Error(`HTTP ${res.status}`)
      setStatus('\u00a1Listo! Gracias por confirmar \ud83d\ude4c', 'success')
      form.reset()
      setTimeout(() => { closeRsvp(); setTimeout(() => setStatus('', ''), 600) }, 1500)
    } catch (err) {
      console.error('[RSVP]', err)
      setStatus('Algo sali\u00f3 mal. Por favor intent\u00e1 de nuevo.', 'error')
      setSubmitting(false)
    }
  })

  // ── Helpers ──
  const setStatus = (msg: string, type: "success" | "error" | "") => {
    statusEl.textContent = msg
    statusEl.className = "rsvp-status" + (type ? ` is-${type}` : "")
  }

  const setSubmitting = (on: boolean) => {
    submitBtn.disabled = on
    submitBtn.textContent = on ? "Enviando…" : "Confirmar"
  }

  // ── Form submit ──
  form.addEventListener("submit", (e) => {
    e.preventDefault()

    if (honeypot.value.trim() !== "") return

    const nombre = (form.elements.namedItem("nombre") as HTMLInputElement).value.trim()
    const apellido = (form.elements.namedItem("apellido") as HTMLInputElement).value.trim()

    if (!nombre || !apellido) {
      setStatus("Por favor completá nombre y apellido.", "error")
      return
    }

    const colectivo = (form.elements.namedItem("colectivo") as HTMLInputElement).checked
    showConfirm({ nombre, apellido, colectivo })
  })

</script>
